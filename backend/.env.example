# WorkMusic backend 环境变量示例
# 复制为 .env 并填入真实值（.env 已被 gitignore，禁止提交）

# LLM（OpenAI 兼容协议）
# DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=deepseek-chat
# 通义：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama 本地：LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:14b

# 故障转移链（贵→贱），逗号分隔
FALLBACK_PROVIDERS=deepseek,qwen,ollama

# PostgreSQL（pgvector）
PG_HOST=localhost
PG_PORT=5432
PG_DB=workmusic
PG_USER=postgres
PG_PASSWORD=postgres

# Redis（缓存 + Streams 打标队列）
REDIS_URL=redis://localhost:6379/0

# Embedding（本地 bge-m3 或 API）
EMBED_BACKEND=ollama
EMBED_MODEL=bge-m3

# 数据目录
DATA_DIR=./data

# 观测
OBS_ENABLED=true
