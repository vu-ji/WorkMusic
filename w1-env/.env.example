# ===== WorkMusic W1 · LLM 配置模板（local-first 三层路由）=====
# 复制本文件为 .env 并填入真实值（.env 已在 .gitignore，不会进版本库）
# 机器：M5 Pro 48G 统一内存 —— r1:32b 可常驻，余量充足

# ---- 本地 Ollama（主用，免费 / 隐私 / 离线）----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama            # ollama 不校验，随意填
OLLAMA_LIGHT_MODEL=qwen2.5:7b    # 日常对话 / W1–W3 验证（快）
OLLAMA_HEAVY_MODEL=deepseek-r1:32b  # W8 复杂推理 / ReAct·ToT（强、慢、带 CoT）

# ---- 云端 DeepSeek（兜底 / 生产质量）----
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 路由策略：light=默认轻量本地；heavy=复杂任务切 r1:32b；cloud=质量兜底自动 fallback
ROUTER_DEFAULT_TIER=light
